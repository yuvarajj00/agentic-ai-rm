# MongoDB Atlas Connection
# Required: Configure this in your Vercel Project Dashboard under:
# Settings > Environment Variables > Add MONGODB_URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Optional Database & Collection overrides (defaults shown below)
MONGODB_DB="agentic_ai_roadmap"
MONGODB_COLLECTION="roadmap_state"

# Local Development Port (defaults to 3000)
PORT=3000

